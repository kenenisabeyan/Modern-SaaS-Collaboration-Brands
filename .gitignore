# ==========================================
# Production .gitignore for WabiSeminar Live
# (React Frontend + Node.js/Express Backend)
# ==========================================

# Dependencies
node_modules/
backend/node_modules/
frontend/node_modules/
package-lock.json.backup

# Production Build Outputs
dist/
dist-ssr/
build/
out/
.next/
frontend/dist/
frontend/dist-ssr/

# Environment Variables & Secrets (NEVER COMMIT)
.env
.env.*
!.env.example
*.env
*.env.*
*.pem
*.key
*.cert

# Database & SQLite files
*.sqlite
*.sqlite3
*.db
backend/database.sqlite

# Logs & Debuggers
logs/
*.log
*build_output*
build_output.txt
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Runtime data & PID files
pids/
*.pid
*.seed
*.pid.lock

# Cache & Temporary Folders
.cache/
.parcel-cache/
.eslintcache/
.stylelintcache/
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/
tmp/
temp/
scratch/
backend/scratch/

# Testing & Coverage
coverage/
*.lcov
.nyc_output/

# Temporary Fix Scripts & Scratch Files
fix_*.js
*.tmp
snippet.txt

# Editor Directories & Files
.vscode/
!.vscode/extensions.json
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.kiro/

# Operating System Files
Thumbs.db
ehthumbs.db
Desktop.ini

# Windows Duplicate Copies
*- Copy/
*- Copy (*)/
*- Copy.*
*- Copy (*).*