# =================================================================
# WabiSeminar Live Deployment Environment Reference
# =================================================================

# -----------------------------------------------------------------
# 1. Vercel (Frontend Project Environment Variables)
# -----------------------------------------------------------------
# Set in Vercel Dashboard -> Project Settings -> Environment Variables:
VITE_API_URL=https://<your-render-backend-name>.onrender.com/api

# -----------------------------------------------------------------
# 2. Render (Backend Web Service Environment Variables)
# -----------------------------------------------------------------
# Set in Render Dashboard -> Web Service -> Environment:
NODE_ENV=production
PORT=5000
USE_SQLITE=false
DATABASE_URL=mysql://4Qe8CQZuyB1e2jm.root:KI5AsN7Edys2nXJx@gateway01.us-west-2.prod.aws.tidbcloud.com:4000/seminar
JWT_SECRET=your-secure-random-jwt-secret
JWT_EXPIRY=24h
PUBLIC_APP_URL=https://covideo.vercel.app
CORS_ORIGIN=https://covideo.vercel.app,https://*.vercel.app,https://*.onrender.com

