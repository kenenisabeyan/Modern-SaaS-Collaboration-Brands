{
  "name": "wabi-seminar-backend",
  "version": "1.0.0",
  "description": "WabiSeminar Live MVP Backend - Real-time video conferencing platform",
  "main": "src/server.js",
  "type": "module",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "build": "npm rebuild sqlite3 || echo 'Backend ready'",
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:ui": "vitest --ui",
    "db:init": "node scripts/init-database.js",
    "db:create-tables": "node -e \"import('./scripts/init-database.js').then(m => m.default())\"",
    "db:reset": "node scripts/reset-database.js",
    "db:check": "node scripts/check-database.js"
  },
  "keywords": [
    "webrtc",
    "video-conferencing",
    "socket.io",
    "real-time",
    "seminar"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.6.5",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "sequelize": "^6.37.8",
    "socket.io": "^4.5.4",
    "sqlite3": "^6.0.1",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/uuid": "^10.0.0",
    "fast-check": "^3.14.0",
    "nodemon": "^3.0.2",
    "vitest": "^1.0.4"
  }
}
