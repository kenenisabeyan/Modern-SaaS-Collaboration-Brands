# Server Configuration
NODE_ENV=development
PORT=5000

# Database Configuration (TiDB Cloud or MySQL)
# TiDB Cloud example:
DATABASE_URL=mysql://username:password@gateway01.us-west-2.prod.aws.tidbcloud.com:4000/database_name
# Local MySQL example:
# DATABASE_URL=mysql://root:password@localhost:3306/wabi_seminar

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRY=24h

# CORS Configuration
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5000
