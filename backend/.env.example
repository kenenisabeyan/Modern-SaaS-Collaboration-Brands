# =================================================================
# Backend Environment Configuration (Render & Production)
# =================================================================

# Server
NODE_ENV=production
PORT=5000

# Database Configuration
# Option A: Built-in SQLite (Zero-config, recommended for fast start)
USE_SQLITE=true
DATABASE_URL=sqlite://./database.sqlite

# Option B: External MySQL / TiDB Cloud / AWS RDS
# USE_SQLITE=false
# DATABASE_URL=mysql://username:password@host:port/database

# JWT Secret & Expiry
JWT_SECRET=change-this-to-a-secure-random-string-in-production
JWT_EXPIRY=24h

# Frontend URLs & CORS (allows Vercel preview & production domains)
PUBLIC_APP_URL=https://covideo.vercel.app
CORS_ORIGIN=https://covideo.vercel.app,https://*.vercel.app,https://*.onrender.com

# Google OAuth (Optional)
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# GOOGLE_CALLBACK_URL=https://<your-render-app>.onrender.com/api/auth/google/callback
